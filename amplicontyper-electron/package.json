{
  "name": "AmpliconTyperGUI",
  "version": "0.1.0",
  "description": "Desktop application for AmpliconTyper",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=26.0.0 <27.0.0"
  },
  "scripts": {
    "format:write": "prettier --plugin prettier-plugin-svelte --write .",
    "format:check": "prettier --plugin prettier-plugin-svelte --check .",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --fix .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "npm run typecheck:node && npm run svelte-check",
    "start": "./scripts/set-dev-env.sh electron-vite preview",
    "dev": "./scripts/set-dev-env.sh electron-vite dev -- --disable-gpu",
    "build": "npm run typecheck && electron-vite build",
    "postinstall-electron": "electron-builder install-app-deps",
    "build-installer": "electron-builder --config electron-builder.config.js",
    "build-installer:unpack": "npm run build-installer -- --dir",
    "build-installer:win": "npm run build-installer -- --win",
    "build-installer:mac": "npm run build-installer -- --mac",
    "build-installer:linux": "npm run build-installer -- --linux",
    "test:unit": "vitest tests/unit/",
    "coverage": "vitest run --coverage",
    "test:e2e": "electron-vite build && xvfb-run npx playwright test"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "ansi_up": "^6.0.6",
    "throttleit": "^3.0.0",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@inlang/paraglide-js": "^2.14.0",
    "@internationalized/date": "^3.12.0",
    "@lucide/svelte": "^1.39.0",
    "@playwright/test": "^1.58.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.1",
    "@vitest/coverage-istanbul": "^4.0.18",
    "ansi-parser": "^3.2.11",
    "bits-ui": "^2.16.3",
    "clsx": "^2.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-svelte": "^3.13.1",
    "formsnap": "^2.0.1",
    "jsdom": "^28.1.0",
    "prettier": "^3.7.4",
    "prettier-plugin-svelte": "^3.4.0",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "svelte": "^5.45.6",
    "svelte-check": "^4.3.4",
    "svelte-tiny-router": "^1.0.8",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.0.18"
  }
}
